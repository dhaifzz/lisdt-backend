# Server configuration
PORT=10000
NODE_ENV=production
CLIENT_URL=https://lisdt.vercel.app
APP_URL=https://lisdt.vercel.app

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[HOST]:5432/postgres"

# Security
JWT_SECRET="your_secure_random_jwt_secret"

# Email Verification (Gmail SMTP)
GMAIL_USER="your_email@gmail.com"
GMAIL_APP_PASSWORD="your_gmail_app_password"

# Server Base URL (for public links / static assets)
SERVER_URL="https://lisdt.onrender.com"

# Supabase Storage (Required in production for user uploads)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key"
SUPABASE_STORAGE_BUCKET="covers"

